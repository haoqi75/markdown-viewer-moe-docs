{
  "name": "markdown-viewer-moe-docs",
  "version": "1.0.0",
  "description": "文档: 由AI生成的Moe Markdown查看器",
  "workspaces": [
    "downloadpage"
  ],
  "scripts": {
    "dev": "vitepress dev",
    "build": "run-s build:docs build:dwpage",
    "build:docs": "vitepress build",
    "build:dwpage": "pnpm run --filter moe-release-downloadpage build:onefile && node scripts/copy-downloadpage.js",
    "preview": "vitepress preview"
  },
  "keywords": [],
  "author": "haoqi75",
  "type": "module",
  "devDependencies": {
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.41"
  },
  "dependencies": {
    "@catppuccin/vitepress": "^0.1.2",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.102.0",
    "vitepress-theme-sakura": "^0.5.1"
  }
}